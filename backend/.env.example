NODE_ENV=development
PORT=5050

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dev-ecommerce

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated web origins allowed in production
CORS_ORIGINS=

# Admin account created/updated by `npm run seed`
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123
